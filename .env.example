CF_DNS_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_EMAIL=your@email.com
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
# Optional: bearer token for monitoring.markridgwell.com/mcp-funfair, the same
# value as MCP_FUNFAIR_AUTH_TOKEN on monitoring (openssl rand -hex 32).
# Unset, ./update uses a random token and the route stays closed.
# FUNFAIR_MCP_TOKEN=your_funfair_mcp_token
# The LAN's ISP-assigned global IPv6 prefix; used for both the firewall rules and the internal-only middleware.
LAN_IPV6_PREFIX=2a02:8010:61d5::/48
# Shared agent memory (credfeto-memory-docker): one bearer token per space
# (openssl rand -hex 32), and the wiki's htpasswd line
# (htpasswd -nbB mark '<password>'; single $ here, this file is not compose).
MEMORY_DEV_TOKEN=your_memory_dev_token
MEMORY_NETADMIN_TOKEN=your_memory_netadmin_token
MEMORY_WIKI_USERS=mark:$2y$05$replace_me
