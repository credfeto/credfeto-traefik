#!/bin/sh

# Locks the proxy's egress down, like the DNS servers. Called by ../update
# (step 8c) as root, after dynamic_conf.yml is rendered.
#
# Ingress is already handled by ../update step 8: Traefik runs on the host,
# not in Docker, so the public zone's rich rules (80/443/853 from the private
# networks) filter it directly.
#
# The rules are one nftables table, inet prx_egress, built and loaded by
# firewall/egress (see there), with one chain, host_out: what the proxy
# itself may connect to. The whole table, address sets included, is replaced
# in one nft transaction, so a refresh never reloads firewalld and a failed
# load keeps the previous rules.
#
# The internal destinations are generated, not listed by hand: every backend
# URL in the rendered /etc/traefik/dynamic_conf.yml (host and port) is
# allowed, re-read on every refresh, so a new route works as soon as
# ../update renders it.
#
# PROXY_FIREWALL_ENFORCE=true in ../.env is the single enforcement knob:
# unmatched new connections are dropped. Otherwise (the default) they still
# flow and are only logged with the prefix "prx-egress-unmatched: ". The same
# rules serve both modes: run in observation mode, check the log for anything
# legitimate, then enforce.

set -eu

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

[ "$(id -u)" -eq 0 ] || die "must run as root"

# One run at a time: proxy-firewall-sync.timer can fire while ../update (or a
# manual run) is still configuring, and concurrent firewall changes would trip
# over each other.
exec 9> /run/lock/credfeto-traefik-firewall.lock
flock 9

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/../.env"
DYNAMIC_CONF="/etc/traefik/dynamic_conf.yml"

env_value() {
    [ -f "${ENV_FILE}" ] || return 0
    grep -E "^[[:space:]]*$1[[:space:]]*=" "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//'
}

ENFORCE="false"
if [ "$(env_value PROXY_FIREWALL_ENFORCE)" = "true" ]; then
    ENFORCE="true"
fi

# firewall/egress reads the backends from here on every run.
[ -r "${DYNAMIC_CONF}" ] || die "${DYNAMIC_CONF} not found - run ../update first"

# --- Retire the firewalld policies and ipsets an earlier version used. Their
# refresh reloaded firewalld every 10 minutes, and a firewalld killed
# mid-reload (for example by the OOM killer) leaves its block-everything table
# behind. One last reload removes them; after this nothing here reloads
# firewalld.
if command -v firewall-cmd > /dev/null 2>&1 && firewall-cmd --state > /dev/null 2>&1; then
    RETIRED=false
    for POLICY in prx-egress; do
        if firewall-cmd --permanent --info-policy="${POLICY}" > /dev/null 2>&1; then
            firewall-cmd --permanent --delete-policy="${POLICY}" > /dev/null || die "Failed to delete policy ${POLICY}"
            RETIRED=true
        fi
    done
    for IPSET in $(firewall-cmd --permanent --get-ipsets); do
        case "${IPSET}" in
            prx-egress-*)
                firewall-cmd --permanent --delete-ipset="${IPSET}" > /dev/null || die "Failed to delete ipset ${IPSET}"
                RETIRED=true
                ;;
        esac
    done
    if [ "${RETIRED}" = "true" ]; then
        info "Removing the old firewalld egress policies..."
        firewall-cmd --reload > /dev/null
    fi
fi
rm -f /usr/local/bin/proxy-refresh-egress-ipsets

info "Configuring egress firewall (enforce ${ENFORCE})..."

# --- The egress table and its refresh timer ---
install -m 755 "${SCRIPT_DIR}/egress" /usr/local/bin/proxy-egress
install -d -m 755 /usr/local/share/credfeto-traefik
install -m 644 "${SCRIPT_DIR}/github-egress-ranges" /usr/local/share/credfeto-traefik/github-egress-ranges
install -m 644 "${SCRIPT_DIR}/cloudflare-egress-ranges" /usr/local/share/credfeto-traefik/cloudflare-egress-ranges
install -m 644 "${SCRIPT_DIR}/proxy-egress-refresh.service" /etc/systemd/system/proxy-egress-refresh.service
install -m 644 "${SCRIPT_DIR}/proxy-egress-refresh.timer" /etc/systemd/system/proxy-egress-refresh.timer

# --- Keep the firewall in step with the repo: firewall/sync pulls and re-runs
# this script when the firewall config changes (e.g. the daily egress-ranges
# commit). A symlink, so the script finds the checkout it lives in.
ln -sfn "${SCRIPT_DIR}/sync" /usr/local/sbin/proxy-firewall-sync
install -m 644 "${SCRIPT_DIR}/proxy-firewall-sync.service" /etc/systemd/system/proxy-firewall-sync.service
install -m 644 "${SCRIPT_DIR}/proxy-firewall-sync.timer" /etc/systemd/system/proxy-firewall-sync.timer

# The settings firewall/egress reads, written before the timers restart so
# that no run picks up stale ones. Keep the paths in sync with firewall/egress.
install -d -m 755 /var/lib/credfeto-traefik
printf '%s\n' "${ENFORCE}" > /var/lib/credfeto-traefik/egress-enforce

systemctl daemon-reload
for UNIT in proxy-egress-refresh.timer proxy-firewall-sync.timer; do
    systemctl enable "${UNIT}" > /dev/null 2>&1
    # restart, not just enable --now: an already-active timer keeps its old
    # schedule otherwise.
    systemctl restart "${UNIT}"
done
# Load the table now rather than at the timer's first run.
/usr/local/bin/proxy-egress

# Record the commit whose firewall config is now live; firewall/sync compares
# against it. Keep the path in sync with firewall/sync.
git -C "${SCRIPT_DIR}" rev-parse HEAD > /var/lib/credfeto-traefik/firewall-applied-head

info "Egress firewall configured (enforce ${ENFORCE})."
